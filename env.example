# ============================================================
# QueryBot Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Database — Microsoft SQL Server
# ------------------------------------------------------------

# Server name. For local SQL Server Express use: localhost\SQLEXPRESS
MSSQL_SERVER=localhost\SQLEXPRESS

# Database name
MSSQL_DATABASE=QueryBotDB

# Set to true for Windows Authentication (recommended for local dev)
# Set to false and provide USERNAME/PASSWORD for SQL Server Authentication
MSSQL_USE_WINDOWS_AUTH=true

# Only required when MSSQL_USE_WINDOWS_AUTH=false
MSSQL_USERNAME=
MSSQL_PASSWORD=

# ODBC driver name — must match what is installed on your machine
# Run: Get-OdbcDriver | Where-Object { $_.Name -like "*SQL Server*" }
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ------------------------------------------------------------
# LLM Provider — switch between openai and groq
# ------------------------------------------------------------

# Options: openai, groq
LLM_PROVIDER=openai

# ------------------------------------------------------------
# OpenAI (used when LLM_PROVIDER=openai)
# ------------------------------------------------------------

# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Chat model — gpt-4o-mini is recommended (fast, low cost)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model — used for ChromaDB schema embedding
# Only active when USE_OPENAI_EMBEDDINGS=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set to true to use OpenAI for embeddings (costs API credits)
# Set to false to use ChromaDB local embeddings (free, slightly lower quality)
USE_OPENAI_EMBEDDINGS=false

# ------------------------------------------------------------
# Groq (used when LLM_PROVIDER=groq)
# Free tier available at: https://console.groq.com
# ------------------------------------------------------------

# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# Chat model
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------
# ChromaDB — Vector Store for Schema RAG
# ------------------------------------------------------------

# Local path where ChromaDB persists the schema embeddings
CHROMA_PERSIST_PATH=chroma_store

# Name of the ChromaDB collection
CHROMA_COLLECTION_NAME=ecommerce_schema

# Number of schema chunks to retrieve per question (1-9 recommended)
TOP_K_CHUNKS=5

# ------------------------------------------------------------
# Agent Configuration
# ------------------------------------------------------------

# Maximum number of SQL regeneration attempts before giving up
MAX_RETRIES=3

# Maximum rows returned per query (hard ceiling — cannot be exceeded)
MAX_ROWS=20

# Enable or disable the LLM guardrail (Layer 2 validation)
# Set to false to reduce latency by ~3 seconds — use for demos
# Set to true for production — catches semantic query errors
ENABLE_LLM_GUARDRAIL=true

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Environment: development or production
# In development: SQLAlchemy echoes all SQL to console
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
